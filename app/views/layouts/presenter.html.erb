<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? "rtl" : "ltr" %>">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Live-session UI: a Turbo cache snapshot (stale page, stale timer,
        dead subscription) must never be shown as a preview. %>
    <meta name="turbo-cache-control" content="no-cache">

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Teach mode: no app chrome, dark. Board and companion both live here. %>
  <body class="min-h-svh bg-teach-bg text-teach-ink antialiased">
    <%= yield %>
  </body>
</html>
